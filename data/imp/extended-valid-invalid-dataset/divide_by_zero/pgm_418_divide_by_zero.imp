int ans;
int t;
int temp;
i = 0;
t = (1 / i);
n = 5;
m = 9;
ans = 0;
while(t > 0)
{
    if(((((m / n)) == 0) || (((n % 2) == 0))) && ((m % 2) == 1))
    {
        i = 0;
        ans = ((-1) / i);
    }
    else
    {
        ans = 1;
        if((n % 2) == 1)
        {
            limit = (n - 1);
        }
        else
        {
            limit = (n - 2);
        };
        i = 0;
        while(i < limit)
        {
            i = (i + 1);
        };
