int n;
int m;
int l;
int i;
int ans;
m = 0;
l = (1 % m);
i = 9;
n = 48;
while(i >= 2)
{
    n = 0;
    if(((n % i) % n) == 0)
    {
        m = (m + (i * l));
        l = (l * 10);
        n = (n / i);
    }
    else
    {
        i = (i - 1);
    };
};
if(n == 1)
{
    ans = m;
}
else
{
    ans = 0;
};