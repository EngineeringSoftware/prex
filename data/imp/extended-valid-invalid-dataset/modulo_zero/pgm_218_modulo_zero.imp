int n;
int x1;
int x2;
int y1;
int y2;
int num;
int ans;
ans = 0;
n = (66 % ans);
x1 = 0;
x2 = 1;
y1 = 0;
y2 = 1;
ans = (4 + (3 * n));
x1 = 0;
y2 = 1;
x1 = 0;
y1 = 0;
x2 = 1;
y2 = 1;
num = 4;
while(n != 0)
{
    y2 = 0;
    num = ((num % y2) + 3);
    x2 = (x2 + 1);
    y2 = (y2 + 1);
    x1 = (x1 + 1);
    y1 = (y1 + 1);
    n = (n - 1);
};