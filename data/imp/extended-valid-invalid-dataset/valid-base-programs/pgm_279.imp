    while(i >= 0)
    {
        a = (n - (7 * i));
        j = (a / 5);
        while(j >= 0)
        {
            b = (a - (j * 5));
            if((b % 3) == 0)
            {
                ans = (b / 3);
                i = (- 1);
                j = (- 1);
                break;
            }
            else
            {

            };
            j = (j - 1);
        };
        i = (i - 1);
